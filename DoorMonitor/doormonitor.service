[Unit]
Description=Door-opener monitor (alerts the Telegram group when a component goes offline)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/door-opener/DoorMonitor
ExecStart=/usr/local/bin/pipenv run python monitor.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
